          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "textOfBlog": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          },
          "imageFile": {
            "$ref": "#/components/schemas/IBrowserFile"
          }
        },
        "additionalProperties": false
      },
      "CreateBlogCommand": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "textOfBlog": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          },
          "imageFile": {
            "$ref": "#/components/schemas/IBrowserFile"
          }
        },
        "additionalProperties": false
      },
      "IBrowserFile": {
        "type": "object",
        "properties": {
          "name": {
