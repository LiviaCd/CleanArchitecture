            "type": "integer",
            "format": "int64",
            "readOnly": true
          },
          "contentType": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "UpdateBlogCommand": {
        "type": "object",
        "properties": {
          "item": {
