{
  "openapi": "3.0.1",
  "info": {
    "title": "eBlog.WebAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/Blog/blogs": {
      "get": {
        "tags": [
          "Blog"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Blog/blog/{id}": {
      "get": {
        "tags": [
          "Blog"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Blog/blog/add": {
      "post": {
        "tags": [
          "Blog"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlogCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlogCommand"
              }
